datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Category {
    NEEDS
    WANTS
    SAVINGS
    INCOME
}

model Transaction {
    id          String   @id @default(cuid())
    amount      Float
    description String
    category    Category
    createdAt   DateTime @default(now())
}
